# Only literal true/false values are accepted for boolean variables.
# Live configuration requires mode=live, ALLOW_LIVE=true, broker=alpaca,
# an explicit account ID, both non-empty credentials, and manual approval.
# No live order adapter is implemented; all live submission remains blocked.
TRADE_AGENT_MODE=paper
TRADE_AGENT_ALLOW_LIVE=false
TRADE_AGENT_BROKER=paper
TRADE_AGENT_ACCOUNT_ID=
TRADE_AGENT_API_KEY_ENV=ALPACA_API_KEY
TRADE_AGENT_SECRET_KEY_ENV=ALPACA_SECRET_KEY
TRADE_AGENT_ACCOUNT_EQUITY=100000.0
TRADE_AGENT_PROPOSAL_CAPITAL=5000.0
TRADE_AGENT_MAX_POSITION_SIZE=0.2
TRADE_AGENT_MAX_DAILY_LOSS=0.02

# Optional configuration; these values do not enable live order submission.
TRADE_AGENT_DATA_PROVIDER=sample_csv
TRADE_AGENT_REQUIRE_MANUAL_APPROVAL=true
TRADE_AGENT_KILL_SWITCH=false

# Dashboard server startup: retry budgets and client timeout (seconds).
TRADE_AGENT_LOG_LEVEL=INFO
TRADE_AGENT_STARTUP_TIMEOUT=30.0
TRADE_AGENT_BIND_ATTEMPTS=5
TRADE_AGENT_STORAGE_ATTEMPTS=3
TRADE_AGENT_REQUEST_TIMEOUT=30.0
